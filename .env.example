# ─── Frontend (public — bundled into the browser) ───
# Leave Supabase blank to run in self-contained demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# demo | live (live requires the two values above)
VITE_APP_MODE=
# true once the ai-assistant and document-extract Edge Functions are deployed with AI secrets
VITE_AI_ENABLED=false

# ─── NEVER put these in .env for the frontend. ───
# They are Supabase Edge Function secrets:  supabase secrets set KEY=value
#   SUPABASE_SERVICE_ROLE_KEY   (provided automatically to functions)
#   APP_URL                     https://app.yourdomain.com
#   ALLOWED_ORIGINS             https://app.yourdomain.com
#   AI_API_URL                  https://api.openai.com/v1/chat/completions (any OpenAI-compatible endpoint)
#   AI_API_KEY
#   AI_MODEL                    e.g. gpt-4o-mini
#   AI_VISION_MODEL             e.g. gpt-4o  (document-extract)
#   AI_SUPPORTS_PDF             true if the model accepts PDF input
#   WHATSAPP_TOKEN              Meta WhatsApp Business Cloud API permanent token
#   WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_TEMPLATE           approved template name with {{1}} title and {{2}} body
#   WHATSAPP_TEMPLATE_LANG      e.g. en
#   RESEND_API_KEY
#   EMAIL_FROM                  "GNANOVA <alerts@yourdomain.com>"
#   N8N_SHARED_SECRET           long random string, also set as GNANOVA_N8N_SECRET in n8n
#   N8N_WEBHOOK_URL             optional: n8n "GNANOVA event" webhook for channel=webhook
