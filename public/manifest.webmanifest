    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Shift report", "url": "/#/field/shift", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stock IN / OUT", "url": "/#/field/store", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Work orders", "url": "/#/field/technician", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
